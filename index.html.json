<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Organigrama Estudio Afín | Roles y Estructura</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #F5F1EB;
      color: #2B2B2D;
    }
    .font-serif-title {
      font-family: 'Playfair Display', serif;
    }
    .role-card {
      transition: all 0.2s ease;
    }
    .role-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 18px -6px rgba(43, 43, 45, 0.14);
    }
    .role-card.selected {
      ring: 2px solid #6E1E2A;
      border-color: #6E1E2A !important;
      background-color: #FFFDFB !important;
    }
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #EFE9E0; }
    ::-webkit-scrollbar-thumb { background: #C8BFB3; border-radius: 3px; }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- HEADER MINIMALISTA -->
  <header class="bg-[#262527] text-[#F5F1EB] border-b border-[#3A383B] sticky top-0 z-30">
    <div class="max-w-[1560px] mx-auto px-4 md:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3">
      
      <!-- Título Oficial -->
      <div>
        <h1 class="font-serif-title text-lg md:text-xl font-bold tracking-tight text-[#FAF8F5]">
          Organigrama Estudio Afín <span class="text-[#C8BFB3] font-normal text-sm md:text-base">| Roles y Estructura</span>
        </h1>
      </div>

      <!-- Controles Limpios -->
      <div class="flex flex-wrap items-center gap-2">
        <!-- Selector de Etapa -->
        <div class="bg-[#1C1B1D] p-1 rounded-lg border border-[#3E3C40] flex items-center text-xs">
          <button onclick="setStage('hoy')" id="btn-stage-hoy" class="px-2.5 py-1 rounded-md font-medium transition-all bg-[#6E1E2A] text-[#FAF8F5]">
            Hoy (2 Socias)
          </button>
          <button onclick="setStage('7proy')" id="btn-stage-7proy" class="px-2.5 py-1 rounded-md font-medium transition-all text-[#B8B0A6] hover:text-white">
            7–12 Proyectos
          </button>
          <button onclick="setStage('escala')" id="btn-stage-escala" class="px-2.5 py-1 rounded-md font-medium transition-all text-[#B8B0A6] hover:text-white">
            Escala
          </button>
        </div>

        <!-- Interruptor Auditoría Ácida -->
        <button onclick="toggleAudit()" id="btn-audit" class="px-2.5 py-1.5 rounded-lg border border-[#4A474C] bg-[#323033] text-[#D8D0C5] hover:text-white text-xs font-medium transition-all">
          Auditoría: OFF
        </button>

        <!-- Selector PC / Móvil -->
        <div class="bg-[#1C1B1D] p-1 rounded-lg border border-[#3E3C40] flex items-center text-xs">
          <button onclick="setDeviceMode('desktop')" id="btn-view-desktop" class="px-2.5 py-1 rounded-md font-medium transition-all bg-[#EFE9E0] text-[#262527]">
            PC
          </button>
          <button onclick="setDeviceMode('mobile')" id="btn-view-mobile" class="px-2.5 py-1 rounded-md font-medium transition-all text-[#B8B0A6] hover:text-white">
            Móvil
          </button>
        </div>
      </div>
    </div>

    <!-- Barra secundaria ultra-compacta: Filtros de área + Resumen de carga -->
    <div class="bg-[#EFE9E0] text-[#2B2B2D] border-b border-[#DCD4C8] px-4 md:px-6 py-2">
      <div class="max-w-[1560px] mx-auto flex flex-wrap items-center justify-between gap-2 text-xs">
        <div id="dept-filters" class="flex items-center gap-1.5 overflow-x-auto pb-0.5 md:pb-0">
          <!-- Render dinámico -->
        </div>
        <div id="load-summary" class="flex items-center gap-3 text-[11px] text-[#5C595E]">
          <!-- Render dinámico -->
        </div>
      </div>
    </div>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="flex-1 max-w-[1560px] w-full mx-auto px-4 md:px-6 py-5 flex gap-6 items-start">
    
    <!-- ÁREA DE ORGANIGRAMA -->
    <div id="org-canvas" class="flex-1 min-w-0">
      <!-- Renderizado dinámico PC o Móvil -->
    </div>

    <!-- PANEL INSPECTOR (Detalle completo al hacer clic) -->
    <aside id="inspector-panel" class="hidden fixed inset-0 z-50 md:static md:inset-auto md:z-10 md:w-[390px] shrink-0 bg-black/40 md:bg-transparent flex items-end md:block">
      <div class="w-full max-h-[85vh] md:max-h-[calc(100vh-135px)] overflow-y-auto bg-[#FAF8F5] rounded-t-2xl md:rounded-xl border border-[#DCD4C8] shadow-xl p-5 md:sticky md:top-32">
        <div class="w-10 h-1 bg-[#D5CEC2] rounded-full mx-auto mb-3 md:hidden"></div>
        <div id="inspector-content"></div>
      </div>
    </aside>

  </main>

  <script>
    const DEPARTMENTS = [
      { id: 'COM', name: 'Comercial & Cliente', color: '#6E1E2A' },
      { id: 'DIS', name: 'Diseño Estratégico', color: '#9A4E55' },
      { id: 'LOG', name: 'Operaciones & Logística', color: '#4E5259' },
      { id: 'TER', name: 'Montaje & Terreno', color: '#7C7269' },
      { id: 'FIN', name: 'Admin & Finanzas', color: '#A68E74' }
    ];

    const LEVELS = [
      { id: 1, title: 'Nivel 1 · Dirección' },
      { id: 2, title: 'Nivel 2 · Liderazgo' },
      { id: 3, title: 'Nivel 3 · Ejecución' },
      { id: 4, title: 'Nivel 4 · Externos' }
    ];

    const SOP_DETAILS = {
      'COM-01': 'Filtro de calificación (CAPEX, plazos y exclusión de anti-clientes) y firma de contrato.',
      'COM-02': 'Correo como único canal vinculante, SLAs de respuesta y órdenes de cambio pagadas por adelantado.',
      'COM-03': 'Inspección final, entrega de dossier a Property Manager, Welcome Book y cobro del 20% final.',
      'DIS-01': 'Levantamiento, Moodboard de conversión (máx. 2 revisiones) y matriz de compras FF&E Open Book.',
      'LOG-01': 'Órdenes de compra tras Hito 2 (30%), acopio transitorio y control de calidad antes de firmar guía.',
      'LOG-02': 'Control excepcional de mueblistas externos homologados: muestras físicas y tolerancia +/- 2 mm.',
      'TER-01': 'Permisos en conserjería 48h antes, protección de ascensores y retiro total de embalajes el mismo día.',
      'TER-02': 'Aseo profundo, montaje escénico (Styling) y pauta fotográfica estándar para Airbnb/Booking.',
      'FIN-01': 'Calendario inamovible 50%-30%-20%, regla de cero financiamiento propio y rendición Open Book.'
    };

    let rolesData = [
      // NIVEL 1
      {
        id: 'com-dir', dept: 'COM', level: 1,
        title: 'Dirección Comercial & Cuentas',
        owners: { hoy: 'Socia A', '7proy': 'Socia A', escala: 'Socia A' },
        mission: 'Liderar alianzas B2B con Property Managers, filtrar inversionistas y cerrar contratos.',
        audit: 'Fusión total de prospección, cuentas y cierre comercial en un solo liderazgo.',
        sops: ['COM-01', 'COM-02'],
        kpis: ['7 proyectos/año', 'NPS 9–10']
      },
      {
        id: 'dis-dir', dept: 'DIS', level: 1,
        title: 'Dirección Creativa & FF&E',
        owners: { hoy: 'Socia A', '7proy': 'Socia A', escala: 'Socia A' },
        mission: 'Definir el concepto visual adaptado al entorno y aprobar el presupuesto FF&E.',
        audit: 'Elimina renders 3D lentos; prioriza Moodboards ágiles orientados a conversión.',
        sops: ['DIS-01'],
        kpis: ['Máx. 2 rondas revisión', 'Lead Time diseño']
      },
      {
        id: 'log-dir', dept: 'LOG', level: 1,
        title: 'Dirección de Operaciones',
        owners: { hoy: 'Socia B', '7proy': 'Socia B', escala: 'Socia B' },
        mission: 'Controlar cadena de abastecimiento, negociar con proveedores y velar por plazos.',
        audit: 'Absorbe dirección de compras y control de proveedores bajo una sola cabeza.',
        sops: ['LOG-01', 'LOG-02'],
        kpis: ['Cumplimiento proveedores', 'Cero quiebres']
      },
      {
        id: 'ter-dir', dept: 'TER', level: 1,
        title: 'Dirección de Montaje',
        owners: { hoy: 'Socia B', '7proy': 'Socia B', escala: 'Socia B' },
        mission: 'Asegurar ejecución llave en mano sin fricciones en edificios y entrega conforme.',
        audit: 'Se unifica bajo Socia B junto a Operaciones para evitar brechas entre compra y obra.',
        sops: ['TER-01', 'COM-03'],
        kpis: ['CSAT > 85%', 'Entrega en fecha']
      },
      {
        id: 'fin-dir', dept: 'FIN', level: 1,
        title: 'Dirección Financiera & Control',
        owners: { hoy: 'Socia B', '7proy': 'Socia B', escala: 'Socia B' },
        mission: 'Custodiar flujo de caja por hitos (50-30-20), aprobar pagos y validar rentabilidad.',
        audit: 'Regla estricta de cero financiamiento propio del mobiliario.',
        sops: ['FIN-01'],
        kpis: ['Variación CAPEX ~ 0%', 'Margen markup']
      },

      // NIVEL 2
      {
        id: 'com-lead', dept: 'COM', level: 2,
        title: 'Ejecutivo Comercial & Handover',
        owners: { hoy: 'Socia A', '7proy': 'Socia A', escala: 'Vacante' },
        mission: 'Gestionar comunicaciones oficiales, órdenes de cambio y entrega de llaves.',
        audit: 'Fusiona Onboarding + Gestión de Cambios + Handover en una sola persona.',
        sops: ['COM-01', 'COM-02', 'COM-03'],
        kpis: ['SLA respuesta < 8h', 'CSAT Handover']
      },
      {
        id: 'dis-lead', dept: 'DIS', level: 2,
        title: 'Diseñador/a FF&E Senior',
        owners: { hoy: 'Socia A', '7proy': 'Socia A', escala: 'Vacante' },
        mission: 'Ejecutar levantamiento en terreno, armar Moodboards y cerrar matriz de compra.',
        audit: 'Absorbe interiorismo + especificación técnica en un perfil integral.',
        sops: ['DIS-01'],
        kpis: ['85–90% compra retail', 'Precisión medidas']
      },
      {
        id: 'log-lead', dept: 'LOG', level: 2,
        title: 'Líder de Procura & Acopio',
        owners: { hoy: 'Socia B', '7proy': 'Vacante', escala: 'Vacante' },
        mission: 'Emitir órdenes de compra, recibir despachos con checklist y coordinar bodega.',
        audit: 'Contratación prioritaria #1 al llegar a 7 proyectos para liberar a Socia B.',
        sops: ['LOG-01', 'LOG-02'],
        kpis: ['Rechazo en 24h', '0 mermas en bodega']
      },
      {
        id: 'ter-lead', dept: 'TER', level: 2,
        title: 'Supervisor/a de Obra & Styling',
        owners: { hoy: 'Socia B', '7proy': 'Socia B', escala: 'Vacante' },
        mission: 'Coordinar permisos en conserjería, supervisar maestros y dirigir styling final.',
        audit: 'Fusiona supervisión técnica en obra + dirección de arte fotográfica.',
        sops: ['TER-01', 'TER-02'],
        kpis: ['Obra limpia 100%', '0 multas edificio']
      },
      {
        id: 'fin-lead', dept: 'FIN', level: 2,
        title: 'Control de Gestión & Open Book',
        owners: { hoy: 'Socia B', '7proy': 'Socia B', escala: 'Vacante' },
        mission: 'Emitir facturas por hitos, rendir boletas Open Book y controlar márgenes.',
        audit: 'Se mantiene interno hasta escala; contabilidad tributaria va 100% externa.',
        sops: ['FIN-01'],
        kpis: ['Cobro 100% pre-compra', 'Cierre Open Book']
      },

      // NIVEL 3
      {
        id: 'dis-exec', dept: 'DIS', level: 3,
        title: 'Asistente Diseño & Cotizaciones',
        owners: { hoy: 'Socia A', '7proy': 'Vacante', escala: 'Vacante' },
        mission: 'Armar láminas de Moodboard, verificar stock en tiendas y actualizar planillas.',
        audit: 'Contratación #2 en crecimiento para liberar horas operativas de Socia A.',
        sops: ['DIS-01'],
        kpis: ['Stock validado 100%', 'Cotización < 48h']
      },
      {
        id: 'ter-exec', dept: 'TER', level: 3,
        title: 'Coordinador Logística & Montaje',
        owners: { hoy: 'Socia B', '7proy': 'Vacante', escala: 'Vacante' },
        mission: 'Ejecutar recepciones físicas, proteger ascensores y asistir armado en terreno.',
        audit: 'Rol puente compartido entre Logística y Terreno para evitar tiempos muertos.',
        sops: ['LOG-01', 'TER-01'],
        kpis: ['Checklist 100% firmado', 'Retiro cartones día 1']
      },

      // NIVEL 4 (EXTERNOS VARIABLES)
      {
        id: 'log-ext', dept: 'LOG', level: 4,
        title: 'Talleres Externos & Bodega',
        owners: { hoy: 'Externo', '7proy': 'Externo', escala: 'Externo' },
        mission: 'Fabricar piezas especiales bajo plano y proveer acopio temporal por proyecto.',
        audit: 'Cero taller carpintero propio (costo fijo eliminado). Pago 100% variable.',
        sops: ['LOG-01', 'LOG-02'],
        kpis: ['Tolerancia +/- 2mm', 'Entrega puntual']
      },
      {
        id: 'ter-ext', dept: 'TER', level: 4,
        title: 'Cuadrillas, Aseo & Fotografía',
        owners: { hoy: 'Externo', '7proy': 'Externo', escala: 'Externo' },
        mission: 'Ejecutar pintura, instalaciones, aseo profundo y fotografía comercial Airbnb.',
        audit: 'Equipos variables contratados por obra bajo protocolo de Obra Limpia.',
        sops: ['TER-01', 'TER-02'],
        kpis: ['0 daños áreas comunes', 'Fotos listas en 48h']
      },
      {
        id: 'fin-ext', dept: 'FIN', level: 4,
        title: 'Contador & Asesor Tributario',
        owners: { hoy: 'Externo', '7proy': 'Externo', escala: 'Externo' },
        mission: 'Llevar contabilidad mensual, declaraciones F29/Renta y cumplimiento SII.',
        audit: 'Externalizado desde el día 1 mediante fee mensual fijo.',
        sops: ['FIN-01'],
        kpis: ['0 multas SII', 'Balance al día']
      }
    ];

    let state = {
      stage: 'hoy',
      showAudit: false,
      activeDept: 'ALL',
      selectedRoleId: null,
      deviceMode: window.innerWidth < 860 ? 'mobile' : 'desktop'
    };

    function getOwnerStyle(owner) {
      if (owner === 'Socia A') return { bg: 'bg-[#6E1E2A]', text: 'text-[#FAF8F5]', label: 'Socia A' };
      if (owner === 'Socia B') return { bg: 'bg-[#3A383C]', text: 'text-[#FAF8F5]', label: 'Socia B' };
      if (owner === 'Externo') return { bg: 'bg-[#E6DDD0]', text: 'text-[#4A4238]', label: 'Externo variable' };
      return { bg: 'bg-transparent border border-dashed border-[#A68E74]', text: 'text-[#7C6852]', label: 'Por contratar' };
    }

    function setStage(stage) {
      state.stage = stage;
      ['hoy', '7proy', 'escala'].forEach(s => {
        const btn = document.getElementById(`btn-stage-${s}`);
        btn.className = s === stage
          ? 'px-2.5 py-1 rounded-md font-medium transition-all bg-[#6E1E2A] text-[#FAF8F5]'
          : 'px-2.5 py-1 rounded-md font-medium transition-all text-[#B8B0A6] hover:text-white';
      });
      renderAll();
    }

    function toggleAudit() {
      state.showAudit = !state.showAudit;
      const btn = document.getElementById('btn-audit');
      btn.textContent = state.showAudit ? 'Auditoría: ON' : 'Auditoría: OFF';
      btn.className = state.showAudit
        ? 'px-2.5 py-1.5 rounded-lg border border-[#8B2635] bg-[#6E1E2A] text-[#FAF8F5] text-xs font-medium transition-all'
        : 'px-2.5 py-1.5 rounded-lg border border-[#4A474C] bg-[#323033] text-[#D8D0C5] hover:text-white text-xs font-medium transition-all';
      renderAll();
    }

    function setDeviceMode(mode) {
      state.deviceMode = mode;
      document.getElementById('btn-view-desktop').className = mode === 'desktop'
        ? 'px-2.5 py-1 rounded-md font-medium transition-all bg-[#EFE9E0] text-[#262527]'
        : 'px-2.5 py-1 rounded-md font-medium transition-all text-[#B8B0A6] hover:text-white';
      document.getElementById('btn-view-mobile').className = mode === 'mobile'
        ? 'px-2.5 py-1 rounded-md font-medium transition-all bg-[#EFE9E0] text-[#262527]'
        : 'px-2.5 py-1 rounded-md font-medium transition-all text-[#B8B0A6] hover:text-white';
      renderAll();
    }

    function setDeptFilter(deptId) {
      state.activeDept = deptId;
      renderAll();
    }

    function selectRole(roleId) {
      state.selectedRoleId = roleId;
      renderAll();
    }

    function closeInspector() {
      state.selectedRoleId = null;
      document.getElementById('inspector-panel').classList.add('hidden');
      renderCanvas();
    }

    function reassignOwner(roleId, newOwner) {
      const role = rolesData.find(r => r.id === roleId);
      if (role) {
        role.owners[state.stage] = newOwner;
        renderAll();
      }
    }

    function renderFiltersAndSummary() {
      const filtersEl = document.getElementById('dept-filters');
      const allActive = state.activeDept === 'ALL';
      let html = `
        <button onclick="setDeptFilter('ALL')" class="px-2.5 py-1 rounded-md font-medium transition-all shrink-0 ${allActive ? 'bg-[#262527] text-[#FAF8F5]' : 'text-[#5C595E] hover:bg-[#E2D9CC]'}">
          Todos (5)
        </button>
      `;
      DEPARTMENTS.forEach(d => {
        const active = state.activeDept === d.id;
        html += `
          <button onclick="setDeptFilter('${d.id}')" class="px-2.5 py-1 rounded-md font-medium transition-all flex items-center gap-1.5 shrink-0 ${active ? 'bg-[#FAF8F5] text-[#262527] shadow-sm border border-[#CFC6B8]' : 'text-[#5C595E] hover:bg-[#E2D9CC]'}">
            <span class="w-2 h-2 rounded-full" style="background:${d.color}"></span>
            <span>${d.id} · ${d.name}</span>
          </button>
        `;
      });
      filtersEl.innerHTML = html;

      // Conteo limpio
      let counts = { 'Socia A': 0, 'Socia B': 0, 'Externo': 0, 'Vacante': 0 };
      rolesData.forEach(r => {
        const o = r.owners[state.stage];
        if (counts[o] !== undefined) counts[o]++;
      });
      document.getElementById('load-summary').innerHTML = `
        <span><strong class="text-[#6E1E2A]">Socia A:</strong> ${counts['Socia A']}</span>
        <span><strong class="text-[#262527]">Socia B:</strong> ${counts['Socia B']}</span>
        <span><strong>Externos:</strong> ${counts['Externo']}</span>
        ${counts['Vacante'] > 0 ? `<span><strong class="text-[#8C6D46]">Por contratar:</strong> ${counts['Vacante']}</span>` : ''}
      `;
    }

    function renderRoleCard(role, dept) {
      const owner = role.owners[state.stage];
      const oStyle = getOwnerStyle(owner);
      const isSelected = state.selectedRoleId === role.id;

      return `
        <div onclick="selectRole('${role.id}')" 
             class="role-card cursor-pointer bg-[#FAF8F5] rounded-lg border ${isSelected ? 'selected' : 'border-[#DCD4C8]'} p-3.5 flex flex-col justify-between gap-2.5"
             style="border-left: 3.5px solid ${dept.color};">
          <div class="text-[13.5px] font-semibold text-[#262527] leading-snug">
            ${role.title}
          </div>
          <div class="flex items-center justify-between gap-2">
            <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium ${oStyle.bg} ${oStyle.text}">
              ${oStyle.label}
            </span>
            <span class="text-[11px] text-[#8A837A]">Detalle →</span>
          </div>
          ${state.showAudit ? `
            <div class="pt-2 border-t border-[#EAE3D8] text-[11px] text-[#6E1E2A] leading-snug">
              ${role.audit}
            </div>
          ` : ''}
        </div>
      `;
    }

    function renderCanvas() {
      const canvas = document.getElementById('org-canvas');
      const visibleDepts = state.activeDept === 'ALL'
        ? DEPARTMENTS
        : DEPARTMENTS.filter(d => d.id === state.activeDept);

      if (state.deviceMode === 'mobile') {
        // VISTA MÓVIL VERTICAL MINIMALISTA
        let html = `<div class="max-w-md mx-auto space-y-5">`;
        visibleDepts.forEach(dept => {
          const deptRoles = rolesData.filter(r => r.dept === dept.id);
          html += `
            <section class="bg-[#EFE9E0]/60 rounded-xl border border-[#DCD4C8] p-3.5">
              <div class="flex items-center gap-2 mb-3 pb-2 border-b border-[#DCD4C8]">
                <span class="w-2.5 h-2.5 rounded-full" style="background:${dept.color}"></span>
                <h2 class="text-xs font-bold uppercase tracking-wider text-[#262527]">${dept.id} · ${dept.name}</h2>
              </div>
              <div class="space-y-2.5">
                ${deptRoles.map(r => `
                  <div>
                    <div class="text-[10px] font-medium text-[#7A746C] mb-1">Nivel ${r.level}</div>
                    ${renderRoleCard(r, dept)}
                  </div>
                `).join('')}
              </div>
            </section>
          `;
        });
        html += `</div>`;
        canvas.innerHTML = html;
        return;
      }

      // VISTA ESCRITORIO: MATRIZ PARALELA LIMPIA
      const gridCols = visibleDepts.length === 1 ? 'grid-cols-1 max-w-md' : 'grid-cols-5';
      let html = `<div class="overflow-x-auto pb-4"><div class="min-w-[1020px]">`;

      // Encabezados de departamento
      html += `<div class="grid ${gridCols} gap-3.5 mb-3">`;
      visibleDepts.forEach(dept => {
        html += `
          <div class="bg-[#FAF8F5] rounded-lg border border-[#DCD4C8] px-3.5 py-2.5 flex items-center gap-2" style="border-top: 3px solid ${dept.color};">
            <span class="text-[11px] font-bold px-1.5 py-0.5 rounded text-white" style="background:${dept.color}">${dept.id}</span>
            <span class="text-xs font-bold text-[#262527] truncate">${dept.name}</span>
          </div>
        `;
      });
      html += `</div>`;

      // Filas jerárquicas paralelas
      html += `<div class="space-y-4">`;
      LEVELS.forEach(lvl => {
        html += `
          <div class="bg-[#EFE9E0]/55 rounded-xl border border-[#E0D8CC] p-3">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-[#6E6860] mb-2.5 px-1">
              ${lvl.title}
            </div>
            <div class="grid ${gridCols} gap-3.5">
              ${visibleDepts.map(dept => {
                const cellRoles = rolesData.filter(r => r.dept === dept.id && r.level === lvl.id);
                if (cellRoles.length === 0) {
                  return `<div class="rounded-lg border border-dashed border-[#D8CFC2] min-h-[76px] flex items-center justify-center text-[11px] text-[#A8A096]">—</div>`;
                }
                return `<div class="space-y-2.5">${cellRoles.map(r => renderRoleCard(r, dept)).join('')}</div>`;
              }).join('')}
            </div>
          </div>
        `;
      });
      html += `</div></div></div>`;
      canvas.innerHTML = html;
    }

    function renderInspector() {
      const panel = document.getElementById('inspector-panel');
      const content = document.getElementById('inspector-content');

      if (!state.selectedRoleId) {
        panel.classList.add('hidden');
        return;
      }

      const role = rolesData.find(r => r.id === state.selectedRoleId);
      if (!role) return;

      const dept = DEPARTMENTS.find(d => d.id === role.dept);
      const currentOwner = role.owners[state.stage];
      panel.classList.remove('hidden');

      content.innerHTML = `
        <div class="flex items-start justify-between gap-2 pb-3 border-b border-[#E5DDD0]">
          <div>
            <span class="inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded text-white mb-1.5" style="background:${dept.color}">
              ${dept.id} · ${dept.name} · Nivel ${role.level}
            </span>
            <h3 class="font-serif-title text-lg font-bold text-[#262527] leading-snug">${role.title}</h3>
          </div>
          <button onclick="closeInspector()" class="text-[#7A746C] hover:text-[#262527] text-lg font-bold px-2">✕</button>
        </div>

        <div class="mt-4 space-y-4 text-xs">
          <!-- Misión -->
          <div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-[#7A746C] mb-1">Responsabilidad Principal</div>
            <p class="text-[#363437] leading-relaxed">${role.mission}</p>
          </div>

          <!-- Criterio Lean / Auditoría -->
          <div class="bg-[#F3ECE2] border border-[#E0D5C5] rounded-lg p-3">
            <div class="text-[10px] font-bold uppercase tracking-wider text-[#6E1E2A] mb-1">Criterio Ultra-Lean</div>
            <p class="text-[#4A3B3D] leading-relaxed">${role.audit}</p>
          </div>

          <!-- Reasignación rápida -->
          <div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-[#7A746C] mb-1.5">Asignado en etapa actual</div>
            <div class="grid grid-cols-2 gap-1.5">
              ${['Socia A', 'Socia B', 'Externo', 'Vacante'].map(opt => `
                <button onclick="reassignOwner('${role.id}', '${opt}')"
                  class="py-1.5 px-2.5 rounded-md border text-left font-medium transition-all ${currentOwner === opt ? 'bg-[#6E1E2A] text-white border-[#6E1E2A]' : 'bg-white text-[#363437] border-[#DCD4C8] hover:border-[#6E1E2A]'}">
                  ${opt === 'Vacante' ? 'Por contratar' : opt}
                </button>
              `).join('')}
            </div>
          </div>

          <!-- SOPs Asociados -->
          <div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-[#7A746C] mb-1.5">SOPs Vinculados</div>
            <div class="space-y-1.5">
              ${role.sops.map(code => `
                <div class="bg-white border border-[#E2DAD0] rounded-lg p-2.5">
                  <div class="font-bold text-[#6E1E2A] mb-0.5">${code}</div>
                  <div class="text-[#524F54] leading-snug">${SOP_DETAILS[code] || ''}</div>
                </div>
              `).join('')}
            </div>
          </div>

          <!-- KPIs -->
          <div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-[#7A746C] mb-1.5">Indicadores Clave (KPIs)</div>
            <div class="flex flex-wrap gap-1.5">
              ${role.kpis.map(k => `
                <span class="px-2.5 py-1 rounded-md bg-[#EFE9E0] text-[#2B2B2D] font-medium">${k}</span>
              `).join('')}
            </div>
          </div>
        </div>
      `;
    }

    function renderAll() {
      renderFiltersAndSummary();
      renderCanvas();
      renderInspector();
    }

    renderAll();
  </script>
</body>
</html>
